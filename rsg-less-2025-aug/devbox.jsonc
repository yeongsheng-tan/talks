{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": {
    "corepack": "latest",
    "nodejs": {
      "version": "26"
    }
  },
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "shell": {
    "init_hook": [
      ". ./set-env.sh"
    ],
    "scripts": {
      "slide-show": [
        "pnpm run dev"
      ]
    }
  }
}
